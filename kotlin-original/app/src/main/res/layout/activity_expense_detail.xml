<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg_primary">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Amount" style="@style/LabelText"/>
            <TextView android:id="@+id/textAmount"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="28sp" android:textStyle="bold"
                android:layout_marginTop="4dp"
                tools:text="R 250,00"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Category" style="@style/LabelText" android:layout_marginTop="16dp"/>
            <TextView android:id="@+id/textCategory"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/accent" android:textSize="16sp" android:textStyle="bold"
                android:layout_marginTop="4dp" tools:text="Food"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Date" style="@style/LabelText" android:layout_marginTop="16dp"/>
            <TextView android:id="@+id/textDate"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_primary" android:textSize="16sp"
                android:layout_marginTop="4dp" tools:text="01 Jan 2026"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Time" style="@style/LabelText" android:layout_marginTop="16dp"/>
            <TextView android:id="@+id/textTimes"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_primary" android:textSize="16sp"
                android:layout_marginTop="4dp" tools:text="09:00 – 10:00"/>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Description" style="@style/LabelText" android:layout_marginTop="16dp"/>
            <TextView android:id="@+id/textDescription"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_primary" android:textSize="16sp"
                android:layout_marginTop="4dp" tools:text="Weekly groceries"/>
        </LinearLayout>

        <ImageView
            android:id="@+id/imagePreview"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="16dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bg_card"
            android:contentDescription="@string/cd_photo_badge"
            android:visibility="gone"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewPhoto"
            style="@style/Widget.BudgetTracker.Button.Outlined"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/btn_view_photo"
            android:visibility="gone"/>
    </LinearLayout>
</ScrollView>
